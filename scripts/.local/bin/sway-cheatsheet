# Fourth page: stock vim motions, plus the centering from remap.lua.
MOTIONS = [
    ("Along a line", [
        ("0 / ^", "start of line / first non-blank"),
        ("$ (Shift-4)", "end of line"),
        ("w / b / e", "next word / back a word / end of word"),
        ("W / B / E", "same, words split only on spaces"),
        ("f x / F x", "jump to next / previous x on the line"),
        ("t x / T x", "jump to just before x"),
        ("; / ,", "repeat last f or t forward / backward"),
    ]),
    ("Up and down", [
        ("gg / G", "top / bottom of file"),
        ("42G or :42", "go to line 42"),
        ("{ / }", "previous / next blank line"),
        ("%", "matching bracket"),
        ("H / M / L", "top / middle / bottom of screen"),
        ("Ctrl-d / Ctrl-u", "half page down / up, centered"),
        ("zz", "center screen on cursor"),
    ]),
    ("Search", [
        ("/text / ?text", "search forward / backward"),
        ("n / N", "next / previous match, centered"),
        ("* / #", "word under cursor forward / backward"),
    ]),
    ("Jumps", [
        ("Ctrl-o / Ctrl-i", "back / forward through jump history"),
        ("ma / 'a", "set mark a / jump back to it"),
    ]),
    ("Motions with operators", [
        ("D / C", "delete / change to end of line"),
        ("dw / cw / yw", "delete / change / yank a word"),
        ("diw / ciw", "delete / change the word under cursor"),
        ('ci" / ci( / cit', "change inside quotes / parens / tag"),
        ("dd / yy / cc", "delete / yank / change the line"),
        ("A / I", "insert at end / start of line"),
        ("o / O", "new line below / above"),
        ("x / r x", "delete char / replace char with x"),
        ("u / Ctrl-r", "undo / redo"),
        (".", "repeat last change"),
        ("v / V / Ctrl-v", "select chars / lines / block"),
    ]),
]


def parse(lines):
    variables = {}
    sections = []  # [heading, [(key, command), ...]]
    current = ["General", []]
    sections.append(current)
    before_mode = None

    for raw in lines:
        line = raw.strip()
        if line.startswith("### "):
            current = [re.sub(r"\s*\(.*\)$", "", line[4:]), []]
            sections.append(current)
            continue
        m = re.match(r'mode\s+"([^"]+)"\s*\{', line)
        if m:
            before_mode = current
            current = [f"{m.group(1).capitalize()} mode", []]
            sections.append(current)
            continue
        if line == "}" and before_mode is not None:
            current, before_mode = before_mode, None
            continue
        m = re.match(r"set\s+(\$\w+)\s+(.+)", line)
        if m:
            variables[m.group(1)] = m.group(2)
            continue
        if not line.startswith("bindsym "):
            continue

        parts = line.split(None, 1)[1].split()
        while parts and parts[0].startswith("--"):
            parts.pop(0)
        key, command = parts[0], " ".join(parts[1:])
        current[1].append((key, command))

    # $mod's value is Mod4, which means nothing to a reader
    display = dict(variables, **{"$mod": "Super"})
    def expand(text):
        for name in sorted(display, key=len, reverse=True):
            text = text.replace(name, display[name])
        return text

    return [
        (heading, [(expand(k), expand(c)) for k, c in binds])
        for heading, binds in sections
        if binds
    ]


def pretty_key(key):
    *mods, last = key.split("+")
    if len(last) == 1:
        last = last.upper()
    return "+".join(mods + [last])


def merge_same_command(binds):
    """Super+h and Super+Left both focus left: show them on one row."""
    merged = {}
    for key, cmd in binds:
        merged.setdefault(cmd, []).append(key)
    return [(" / ".join(keys), cmd) for cmd, keys in merged.items()]


def collapse(binds):
    """Fold runs like Super+1..Super+0 -> workspace number 1..10 into one row."""
    out = []
    for key, cmd in binds:
        km = re.match(r"(.*\+)(\d)$", key)
        cm = re.match(r"(.*?)(\d+)$", cmd)
        if km and cm and out and out[-1][2] == (km.group(1), cm.group(1)):
            prev = out[-1]
            out[-1] = (prev[0], prev[1], prev[2], km.group(2), cm.group(2))
            continue
        group = (km.group(1), cm.group(1)) if km and cm else None
        out.append((key, cmd, group, None, None))

    rows = []
    for key, cmd, group, last_k, last_c in out:
        if last_k is not None:
            key = f"{key}..{last_k[-1]}"
            cmd = f"{cmd}..{last_c}"
        rows.append((key, cmd))
    return rows


def rows(binds):
    return merge_same_command(collapse([(pretty_key(k), c) for k, c in binds]))


def label(cmd):
    cmd = cmd.removeprefix("exec ")
    if cmd.startswith("swaynag") and "swaymsg exit" in cmd:
        cmd = "log out"
    cmd = LABELS.get(cmd, cmd)
    if len(cmd) > MAX_CMD:
        cmd = cmd[: MAX_CMD - 3] + "..."
    return cmd


def render(sections, footer):
    width = max(len(k) for _, binds in sections for k, _ in binds)
    out = []
    for heading, binds in sections:
        out.append(f"{BOLD}{heading}{RESET}")
        for key, desc in binds:
            out.append(f"  {key:<{width}}  {desc}")
        out.append("")
    out.append(footer)
    return "\n".join(out) + "\n"


def main():
    sway = [
        (heading, [(key, label(cmd)) for key, cmd in rows(binds)])
        for heading, binds in parse(CONFIG.read_text().splitlines())
    ]
    footer = "s sway, g git, v nvim, m motions, any other key to close"
    pages = {
        "s": render(sway, footer),
        "g": render(GIT, footer),
        "v": render(NVIM, footer),
        "m": render(MOTIONS, footer),
    }
    # No pager: less isn't installed here, and each page fits the window.
    if not sys.stdin.isatty():
        sys.stdout.write("\n".join(pages.values()))
        return
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    page = "s"
    try:
        tty.setcbreak(fd)
        while page in pages:
            sys.stdout.write("\033[H\033[2J" + pages[page])
            sys.stdout.flush()
            page = sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)


if __name__ == "__main__":
    main()
