        ("git branch", "list branches"),
    ]),
    ("Commit", [
        ("git add FILE", "stage a file"),
        ("git add -p", "pick which hunks to stage"),
        ("git restore --staged FILE", "unstage, keep the edits"),
        ("git restore FILE", "throw away unstaged edits (no undo)"),
        ('git commit -s -m "msg"', "commit with DCO sign-off"),
        ("git commit --amend", "fix up the last commit"),
    ]),
    ("Sync with upstream", [
