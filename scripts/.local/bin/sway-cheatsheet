#!/usr/bin/env python3
"""Print the bindsym lines from the sway config, grouped under its ### headings.

Read from the live config rather than a hand-kept list, so the sheet can't
drift out of date when a binding changes.
"""
import re
import sys
import termios
import tty
from pathlib import Path

CONFIG = Path.home() / ".config/sway/config"
BOLD, RESET = "\033[1m", "\033[0m"
MAX_CMD = 64

