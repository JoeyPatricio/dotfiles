#!/usr/bin/env python3
"""Show one blank workspace after the used ones, as a waybar module.

    sway-next-workspace --watch   print waybar JSON now and on every change
    sway-next-workspace --go      switch to that blank workspace

sway deletes an empty workspace as soon as you leave it, so a real blank
workspace can't be kept open. Instead the bar shows the next free number
after the highest used one, and --go creates it on click. If you're already
on an empty workspace, that one is the blank and nothing extra is shown.
"""
import json
import subprocess
import sys


def swaymsg(kind):
    return json.loads(subprocess.run(["swaymsg", "-r", "-t", kind],
                                     capture_output=True, text=True, check=True).stdout)


def has_windows(node):
    if node.get("pid"):
        return True
    return any(has_windows(n) for n in node.get("nodes", []) + node.get("floating_nodes", []))


def next_blank():
    """Number of the blank workspace to show, or None if one already exists."""
    workspaces = []
    for output in swaymsg("get_tree")["nodes"]:
        for ws in output.get("nodes", []):
            if ws["type"] == "workspace" and ws["name"] != "__i3_scratch":
                workspaces.append(ws)
    if any(not has_windows(ws) for ws in workspaces):
        return None
    numbers = [ws["num"] for ws in workspaces if ws.get("num", -1) >= 1]
    return max(numbers, default=0) + 1


def emit():
    n = next_blank()
    # Empty text makes waybar hide the module.
    print(json.dumps({"text": "" if n is None else str(n), "tooltip": ""}), flush=True)


def watch():
    emit()
    events = subprocess.Popen(
        ["swaymsg", "-m", "-r", "-t", "subscribe", '["workspace", "window"]'],
        stdout=subprocess.PIPE, text=True)
    for _ in events.stdout:
        emit()


def main():
    if sys.argv[1:] == ["--watch"]:
        watch()
    elif sys.argv[1:] == ["--go"]:
        n = next_blank()
        if n is not None:
            subprocess.run(["swaymsg", f"workspace number {n}"], stdout=subprocess.DEVNULL)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
