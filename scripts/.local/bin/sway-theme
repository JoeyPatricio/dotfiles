#!/usr/bin/env python3
"""Switch the desktop palette or wallpaper.

    sway-theme                 list palettes and wallpapers, current one marked *
    sway-theme NAME            apply ~/dotfiles/themes/NAME.ini
    sway-theme --pick          choose a palette in fuzzel
    sway-theme -w NAME         wallpaper ~/dotfiles/wallpapers/NAME.*
    sway-theme --next          next wallpaper (wraps around)
    sway-theme --pick-wallpaper  choose a wallpaper in fuzzel

A wallpaper keeps the colors of themes/default.ini (white on black) and only
changes the accent: borders, the active workspace, the launcher selection.
The accent is picked from the image. To pick it yourself, add NAME=rrggbb to
wallpapers/accents.ini.

Each program's config pulls its colors from a small generated file (sway
include, waybar @import, foot/fuzzel/mako include). This script only rewrites
those files, so the hand-written configs never change when the palette does.
swaylock has no include, and its config is nothing but colors, so it's
generated whole.
"""

import colorsys
import re
import subprocess
import sys
from pathlib import Path

DOT = Path.home() / "dotfiles"
THEMES = DOT / "themes"
WALLPAPERS = DOT / "wallpapers"
ACCENTS = WALLPAPERS / "accents.ini"
CURRENT = THEMES / "current"
WALLPAPER_BASE = "default"
IMAGE_TYPES = {".png", ".jpg", ".jpeg"}
# Images at most this wide/tall are patterns and get tiled, bigger ones fill.
TILE_MAX = 256
# Window opacity, 1.0 = solid. Terminals get it as background-only alpha so
# text stays sharp. Every other window is faded whole by sway, text included.
OPACITY = 0.95
# foot windows go by these app_ids. They're excluded from sway's opacity
# because foot already handles its own.
FOOT_APP_IDS = ["foot", "cheatsheet", "yazi"]

UI = ["bg", "panel", "dim", "fg", "accent", "hi", "red"]
OPTIONAL = ["accent_text"]
TERM = [f"regular{i}" for i in range(8)] + [f"bright{i}" for i in range(8)]


def read_ini(path):
    values = {}
    for line in path.read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if line:
            key, value = (s.strip() for s in line.split("=", 1))
            values[key] = value.lower()
    return values


def load(name):
    path = THEMES / f"{name}.ini"
    if not path.is_file():
        sys.exit(f"no palette {path}. Available: {', '.join(names())}")
    p = read_ini(path)
    missing = [k for k in UI + TERM if k not in p]
    bad = [k for k, v in p.items() if not re.fullmatch(r"[0-9a-f]{6}", v)]
    if missing or bad:
        sys.exit(f"{path}: missing {missing or 'nothing'}, bad hex {bad or 'none'}")
    # Text drawn on top of the accent (focused title, active workspace,
    # selected launcher row). Defaults to bg, which works for bright accents.
    # Dark accents need a light color here instead.
    p.setdefault("accent_text", p["bg"])
    return p


def names():
    return sorted(f.stem for f in THEMES.glob("*.ini"))


def wallpapers():
    return sorted(f for f in WALLPAPERS.iterdir() if f.suffix.lower() in IMAGE_TYPES)


def find_wallpaper(name):
    for f in wallpapers():
        if f.stem == name:
            return f
    sys.exit(
        f"no wallpaper {name}. Available: {', '.join(f.stem for f in wallpapers())}"
    )


# Colors -------------------------------------------------------------------


def rgb(hexstr):
    return tuple(int(hexstr[i : i + 2], 16) / 255 for i in (0, 2, 4))


def to_hex(r, g, b):
    return "".join(f"{round(c * 255):02x}" for c in (r, g, b))


def luminance(hexstr):
    def lin(c):
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4

    r, g, b = (lin(c) for c in rgb(hexstr))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b):
    la, lb = sorted((luminance(a), luminance(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def accent_from_image(path):
    """Most common saturated color in the image, lightened until it stands out on black.

    Greyscale images (Houndstooth, Black Thatch) have no saturated color, so
    they get their lightest shade instead.
    """
    out = subprocess.run(
        ["magick", str(path), "-colors", "16", "-format", "%c", "histogram:info:-"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    colors = [
        (int(n), h.lower())
        for n, h in re.findall(r"^\s*(\d+):.*?#([0-9A-Fa-f]{6})", out, re.M)
    ]
    hsv = {h: colorsys.rgb_to_hsv(*rgb(h)) for _, h in colors}
    saturated = [(n, h) for n, h in colors if hsv[h][1] >= 0.25 and hsv[h][2] >= 0.25]
    if saturated:
        color = max(saturated, key=lambda c: c[0] * hsv[c[1]][1] * hsv[c[1]][2])[1]
    else:
        color = max(colors, key=lambda c: luminance(c[1]))[1]
    # A border on a black desktop needs to be visible, and the accent is
    # also a background for text. Mix toward white until it's 4:1 on black.
    r, g, b = rgb(color)
    for _ in range(20):
        if contrast(to_hex(r, g, b), "000000") >= 4:
            break
        r, g, b = (c + (1 - c) * 0.1 for c in (r, g, b))
    return to_hex(r, g, b)


def wallpaper_palette(path):
    p = load(WALLPAPER_BASE)
    overrides = read_ini(ACCENTS) if ACCENTS.exists() else {}
    p["accent"] = overrides.get(path.stem) or accent_from_image(path)
    p["accent_text"] = max(("ffffff", "000000"), key=lambda t: contrast(p["accent"], t))
    return p


def image_size(path):
    out = subprocess.run(
        ["magick", "identify", "-format", "%w %h", str(path)],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    return tuple(int(v) for v in out.split())


# Rendering ----------------------------------------------------------------


def render(source, p, wallpaper=None):
    note = f"Generated by sway-theme from {source}. Edit that, not this file."
    term = "\n".join(f"{k}={p[k]}" for k in TERM)
    if wallpaper:
        mode = "tile" if max(image_size(wallpaper)) <= TILE_MAX else "fill"
        # ~ rather than the absolute path, so the generated file works for
        # any username. sway expands it.
        where = "~/" + str(wallpaper.relative_to(Path.home()))
        background = f'output * bg "{where}" {mode}\n'
    else:
        background = f"output * bg #{p['bg']} solid_color\n"
    return {
        "sway/.config/sway/theme": f"# {note}\n"
        + "".join(f"set ${k} #{p[k]}\n" for k in UI + OPTIONAL)
        + f"set $opacity {OPACITY}\n"
        + background,
        "waybar/.config/waybar/theme.css": f"/* {note} */\n"
        + "".join(f"@define-color {k} #{p[k]};\n" for k in UI + OPTIONAL),
        "foot/.config/foot/theme.ini": f"""# {note}
[colors-dark]
alpha={OPACITY}
background={p["bg"]}
foreground={p["fg"]}
cursor={p["accent_text"]} {p["accent"]}
selection-foreground={p["bg"]}
selection-background={p["hi"]}
{term}
""",
        "fuzzel/.config/fuzzel/theme.ini": f"""# {note}
[colors]
background={p["bg"]}ff
text={p["fg"]}ff
prompt={p["hi"]}ff
input={p["hi"]}ff
match={p["hi"]}ff
selection={p["accent"]}ff
selection-text={p["accent_text"]}ff
selection-match={p["accent_text"]}ff
border={p["accent"]}ff
""",
        "mako/.config/mako/theme": f"""# {note}
background-color=#{p["bg"]}
text-color=#{p["fg"]}
border-color=#{p["accent"]}

[urgency=high]
border-color=#{p["red"]}
""",
        "swaylock/.config/swaylock/config": f"""# {note}
color={p["bg"]}
font=Terminus
indicator-radius=70
indicator-thickness=6
inside-color={p["bg"]}
ring-color={p["dim"]}
key-hl-color={p["accent"]}
bs-hl-color={p["red"]}
text-color={p["fg"]}
line-color=00000000
separator-color=00000000
inside-ver-color={p["bg"]}
ring-ver-color={p["hi"]}
text-ver-color={p["hi"]}
inside-wrong-color={p["bg"]}
ring-wrong-color={p["red"]}
text-wrong-color={p["red"]}
""",
    }


def recolor_open_terminals(p):
    """Send OSC color escapes to every foot window's tty.

    foot only reads its config at startup, so without this, open terminals
    keep the old palette until they're closed.
    """
    # The [NN] prefix on OSC 11 is background alpha in percent.
    osc = [
        f"\033]10;#{p['fg']}\033\\",
        f"\033]11;[{round(OPACITY * 100)}]#{p['bg']}\033\\",
        f"\033]12;#{p['accent']}\033\\",
    ]
    osc += [f"\033]4;{i};#{p[k]}\033\\" for i, k in enumerate(TERM)]
    seq = "".join(osc)
    ttys = set()
    for pid in subprocess.run(
        ["pgrep", "-x", "foot"], capture_output=True, text=True
    ).stdout.split():
        children = Path(f"/proc/{pid}/task/{pid}/children")
        for child in children.read_text().split() if children.exists() else []:
            try:
                tty = Path(f"/proc/{child}/fd/0").resolve()
            except OSError:
                continue
            if str(tty).startswith("/dev/pts/"):
                ttys.add(tty)
    for tty in ttys:
        try:
            with open(tty, "w") as f:
                f.write(seq)
        except OSError:
            pass
    return len(ttys)


NOT_FOOT = f'app_id="^(?!({"|".join(FOOT_APP_IDS)})$).*"'


def run(*cmd):
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def write_and_reload(current, source, p, wallpaper=None):
    for rel, text in render(source, p, wallpaper).items():
        (DOT / rel).write_text(text)
    CURRENT.write_text(current + "\n")
    run("swaymsg", "reload")
    # for_window rules only touch windows opened after them, so set the
    # opacity on everything already open too.
    run("swaymsg", f"[{NOT_FOOT}] opacity {OPACITY}")
    run("swaymsg", f'[class=".*"] opacity {OPACITY}')
    run("pkill", "-USR2", "-x", "waybar")
    run("makoctl", "reload")
    n = recolor_open_terminals(p)
    print(f"{current}: applied, accent #{p['accent']}, {n} open terminal(s) recolored")


def apply(name):
    write_and_reload(name, f"themes/{name}.ini", load(name))


def apply_wallpaper(path):
    write_and_reload(
        f"wallpaper/{path.stem}",
        f"wallpapers/{path.name} + themes/{WALLPAPER_BASE}.ini",
        wallpaper_palette(path),
        path,
    )


# Commands -----------------------------------------------------------------


def current():
    return CURRENT.read_text().strip() if CURRENT.exists() else None


def fuzzel(prompt, items, now):
    menu = "\n".join(f"{i} *" if i == now else i for i in items)
    choice = subprocess.run(
        ["fuzzel", "--dmenu", f"--prompt={prompt}> "],
        input=menu,
        capture_output=True,
        text=True,
    ).stdout.strip()
    return choice.removesuffix(" *")


def next_wallpaper():
    walls = wallpapers()
    now = current() or ""
    stems = [f.stem for f in walls]
    i = (
        stems.index(now.removeprefix("wallpaper/")) + 1
        if now.removeprefix("wallpaper/") in stems
        else 0
    )
    apply_wallpaper(walls[i % len(walls)])


def main():
    args = sys.argv[1:]
    now = current()
    if not args:
        for n in names():
            print(f"{'*' if n == now else ' '} {n}")
        for f in wallpapers():
            print(f"{'*' if f'wallpaper/{f.stem}' == now else ' '} -w {f.stem}")
    elif args == ["--pick"]:
        choice = fuzzel("theme", names(), now)
        if choice:
            apply(choice)
    elif args == ["--pick-wallpaper"]:
        choice = fuzzel(
            "wallpaper",
            [f.stem for f in wallpapers()],
            (now or "").removeprefix("wallpaper/"),
        )
        if choice:
            apply_wallpaper(find_wallpaper(choice))
    elif args == ["--next"]:
        next_wallpaper()
    elif len(args) == 2 and args[0] == "-w":
        apply_wallpaper(find_wallpaper(args[1]))
    else:
        apply(args[0])


if __name__ == "__main__":
    main()
