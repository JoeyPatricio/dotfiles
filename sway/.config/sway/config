# Colors: $bg $panel $dim $fg $accent $accent_text $hi $red, written by sway-theme
include ~/.config/sway/theme

set $mod   Mod4
set $left  h
set $down  j
set $up    k
set $right l
set $term  foot
set $menu  fuzzel

font pango:Terminus 12

default_border pixel 2
default_floating_border pixel 2
# New workspaces start tabbed, like pressing Super+W. Super+E goes back to split.
workspace_layout tabbed

# class                 border  bg      text    indicator child_border
client.focused          $accent $accent $accent_text $hi  $accent
client.focused_inactive $dim    $panel  $fg     $dim      $dim
client.unfocused        $panel  $bg     $dim    $panel    $panel
client.urgent           $red    $red    $bg     $red      $red

# See-through windows. $opacity comes from sway-theme. foot does its own
# background-only transparency, so its windows are left out here.
for_window [app_id="^(?!(foot|cheatsheet|yazi|notes)$).*"] opacity $opacity
for_window [class=".*"] opacity $opacity

for_window [app_id="cheatsheet"] floating enable, resize set 840 940, move position center

# Lecture notes (Super+N): floats down the right side on every workspace.
# Scratchpad so the same key hides it again. See ~/.local/bin/lecture-notes.
for_window [app_id="notes"] floating enable, sticky enable, resize set 40 ppt 90 ppt, move position 59 ppt 5 ppt, move scratchpad, scratchpad show

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

# Lock after 5 min, screen off after 10, lock before suspend
exec swayidle -w \
    timeout 300 'swaylock -f' \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f'

exec waybar
exec mako
exec nm-applet --indicator
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec ~/.local/bin/sway-battery-watch
# Clipboard history for Super+C. Stores text and images.
exec wl-paste --watch cliphist store
# A terminal to start with. exec, not exec_always, so reloading doesn't open more.
exec $term

### Basics
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+s exec google-chrome-stable --new-window https://www.google.com
bindsym $mod+f exec foot --app-id=yazi yazi ~
bindsym $mod+n exec ~/.local/bin/lecture-notes
bindsym $mod+Shift+n exec ~/.local/bin/lecture-notes --pick
bindsym $mod+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'
bindsym $mod+Escape exec ~/.local/bin/sway-power
bindsym $mod+c exec cliphist list | fuzzel --dmenu --with-nth=2 --prompt='clipboard> ' | cliphist decode | wl-copy
bindsym $mod+i exec foot --app-id=cheatsheet ~/.local/bin/sway-cheatsheet
bindsym $mod+t exec ~/.local/bin/sway-theme --next
bindsym $mod+Shift+t exec ~/.local/bin/sway-theme --pick-wallpaper
bindsym $mod+Ctrl+t exec ~/.local/bin/sway-theme --pick
floating_modifier $mod normal

### Focus and move
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right
bindsym $mod+Left   focus left
bindsym $mod+Down   focus down
bindsym $mod+Up     focus up
bindsym $mod+Right  focus right

bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left   move left
bindsym $mod+Shift+Down   move down
bindsym $mod+Shift+Up     move up
bindsym $mod+Shift+Right  move right

### Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

### Layout
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+Shift+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

mode "resize" {
    bindsym $left  resize shrink width 20px
    bindsym $down  resize grow height 20px
    bindsym $up    resize shrink height 20px
    bindsym $right resize grow width 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### Laptop keys (--locked so they work on the lock screen)
bindsym --locked XF86AudioRaiseVolume  exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute         exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute      exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp   exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-

### Screenshots: region to clipboard, whole screen to ~/Pictures
bindsym Print       exec grim -g "$(slurp)" - | wl-copy
bindsym Shift+Print exec grim ~/Pictures/screenshot-$(date +%F-%H%M%S).png

# Arch's snippets: pass WAYLAND_DISPLAY etc. to systemd and D-Bus.
# Portals, mako's D-Bus activation and the keyring depend on it.
include /etc/sway/config.d/*

# This machine's own settings (monitors, input), created by machine-init.
# Last so it can override anything above. Not in the dotfiles repo.
include ~/.config/machine/sway.conf
